# SMTP settings for appointment confirmation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=ChatWithGP
EMAIL_FROM_ADDRESS=

# Protects the scheduled email worker endpoint; use a long random value.
CRON_SECRET=

# Time zone used to format appointment dates in email.
APPOINTMENT_TIME_ZONE=Asia/Kolkata
